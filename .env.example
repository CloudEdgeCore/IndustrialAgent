# ===== PostgreSQL / TimescaleDB / pgvector =====
POSTGRES_USER=industrial
POSTGRES_PASSWORD=industrial
POSTGRES_DB=industrial_agent

# 本地开发（宿主机执行后端时使用）
DATABASE_URL=postgresql+psycopg://industrial:industrial@localhost:5432/industrial_agent

# ===== Redis =====
# 主机端口 16379（避免与本机其他项目的 Redis 冲突），容器内部仍为 6379
REDIS_URL=redis://localhost:16379/0

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# ===== LLM（OpenAI-compatible，P3 阶段启用）=====
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
