# ===== PostgreSQL / TimescaleDB / pgvector =====
POSTGRES_USER=industrial
POSTGRES_PASSWORD=industrial
POSTGRES_DB=industrial_agent

# 本地开发（宿主机执行后端时使用）
DATABASE_URL=postgresql+psycopg://industrial:industrial@localhost:5432/industrial_agent

# Tool 层只读账号（架构 §15；由迁移创建，仅 SELECT 权限）
TOOL_DATABASE_URL=postgresql+psycopg://tool_ro:tool_ro@localhost:5432/industrial_agent

# ===== Redis =====
# 主机端口 16379（避免与本机其他项目的 Redis 冲突），容器内部仍为 6379
REDIS_URL=redis://localhost:16379/0

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# ===== LLM（OpenAI-compatible，P3 启用；默认 Qwen DashScope 兼容模式）=====
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# LLM_API_KEY=sk-xxxxxxxx

# ===== 认证（生产必须修改 JWT_SECRET）=====
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=720

# ===== Embedding（OpenAI-compatible；不配置则用确定性本地实现，离线可测）=====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
